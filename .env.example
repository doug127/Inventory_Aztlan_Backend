# Entorno
NODE_ENV=development # production | development | test
PORT=3000

# Configuración de la base de datos
DB_DIALECT=postgres # postgres | mysql | sqlite | mssql
DB_HOST=localhost 
DB_PORT=5432
DB_NAME=db_name
DB_USER=postgres
DB_PASSWORD=your_password

# Seguridad / Auth
JWT_SECRET=una_clave_super_secreta
SESSION_SECRET=otra_clave_secreta

# Cookie del refresh token: true exige HTTPS (en production siempre es true)
COOKIE_SECURE=false

# Intentos de login fallidos permitidos por minuto y por IP (por defecto 10)
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Solicitudes de "olvidé mi contraseña" por hora y por IP (por defecto 3)
FORGOT_PASSWORD_RATE_LIMIT_PER_HOUR=3
# Intentos fallidos de restablecer la contraseña cada 15 minutos por IP (por defecto 10)
RESET_PASSWORD_RATE_LIMIT_PER_15_MIN=10

# URL del frontend: se usa para CORS y para armar el enlace de recuperación de contraseña
FRONTEND_URL=http://localhost:5173

# Correo (SMTP). Por defecto apunta a Mailpit, un servidor de pruebas: bandeja en http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Inventario Aztlan <no-reply@aztlan.local>

# Worker de la cola de correos (arranca con el servidor)
EMAIL_WORKER_ENABLED=true
EMAIL_WORKER_INTERVAL_MS=10000
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_MS=60000

# Herramientas de desarrollo (/api/dev, solo desde localhost y nunca en producción)
ENABLE_DEV_TOOLS=false

# SUPERADMIN inicial: obligatoria para sembrar y para `pnpm db:reset-superadmin`.
# Mínimo 8 caracteres, con al menos una mayúscula, una minúscula y un número.
SEED_SUPERADMIN_EMAIL=superadmin@aztlan.local
SEED_SUPERADMIN_PASSWORD=

# Usuarios de prueba (uno por rol), todos con la misma contraseña. Si se deja vacía se usa la
# del SUPERADMIN. `pnpm db:seed:demo-users` los crea o los restablece. No se crean en producción.
SEED_USERS_PASSWORD=
SEED_USERS_EMAIL_DOMAIN=aztlan.local

# Carpeta donde se guardan los archivos adjuntos (documentos de recepción escaneados). Relativa a backend/.
FILE_STORAGE_DIR=storage
