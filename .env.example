# Entorno
NODE_ENV=development # production | development | test
PORT=3000

# Configuración de la base de datos
DB_DIALECT=postgres # postgres | mysql | sqlite | mssql
DB_HOST=localhost 
DB_PORT=5432
DB_NAME=db_name
DB_USER=postgres
DB_PASSWORD=your_password

# Seguridad / Auth
JWT_SECRET=una_clave_super_secreta
SESSION_SECRET=otra_clave_secreta

# Cookie del refresh token: true exige HTTPS (en production siempre es true)
COOKIE_SECURE=false

# Intentos de login fallidos permitidos por minuto y por IP (por defecto 10)
LOGIN_RATE_LIMIT_PER_MINUTE=10

# SUPERADMIN inicial: obligatoria para sembrar y para `pnpm db:reset-superadmin`.
# Mínimo 8 caracteres, con al menos una mayúscula, una minúscula y un número.
SEED_SUPERADMIN_EMAIL=superadmin@aztlan.local
SEED_SUPERADMIN_PASSWORD=
